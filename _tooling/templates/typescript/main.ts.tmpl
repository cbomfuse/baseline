/**
 * CBOM ground-truth corpus - TypeScript (Node.js) implementation.
 *
 * Runs scenarios S01-S24 in the same order, with the same inputs and the same
 * output lines as the Python, Java, Go and C# implementations. All hard-coded
 * keys, IVs, salts and passwords are published test vectors - never reuse them.
 */
// reflect-metadata is a runtime polyfill required by @peculiar/x509 (tsyringe).
import "reflect-metadata";
«imp lib.node#node:crypto|import * as crypto from "node:crypto";»
«imp lib.node#node:tls|import * as tls from "node:tls";»
«imp lib.noble-ciphers#@noble/ciphers/chacha.js|import { chacha20poly1305 } from "@noble/ciphers/chacha.js";»
«imp lib.noble-ciphers#@noble/ciphers/utils.js|import { randomBytes } from "@noble/ciphers/utils.js";»
«imp lib.noble-curves#@noble/curves/ed25519.js|import { ed25519 } from "@noble/curves/ed25519.js";»
«imp lib.noble-hashes#@noble/hashes/argon2.js|import { argon2id } from "@noble/hashes/argon2.js";»
«imp lib.noble-hashes#@noble/hashes/blake2.js|import { blake2b } from "@noble/hashes/blake2.js";»
«imp lib.noble-hashes#@noble/hashes/sha3.js|import { sha3_256 } from "@noble/hashes/sha3.js";»
«imp lib.noble-pq#@noble/post-quantum/ml-dsa.js|import { ml_dsa65 } from "@noble/post-quantum/ml-dsa.js";»
«imp lib.noble-pq#@noble/post-quantum/ml-kem.js|import { ml_kem768 } from "@noble/post-quantum/ml-kem.js";»
«imp lib.peculiar-x509#@peculiar/x509|import * as x509 from "@peculiar/x509";»
«imp lib.bcryptjs#bcryptjs|import bcrypt from "bcryptjs";»

type Bytes = Uint8Array<ArrayBuffer>;

// The W3C Web Cryptography API as implemented by Node.js (distinct from node:crypto).
const subtle = globalThis.crypto.subtle;

const MESSAGE = utf8("The quick brown fox jumps over the lazy dog");

// --- Hard-coded material (public test vectors only) ---
// Wikipedia HMAC example key
const «mat m.hmac-key|HMAC_KEY = utf8("key")»;
// RFC 5869 A.1
const «mat m.hkdf-ikm|HKDF_IKM = new Uint8Array(22).fill(0x0b)»;
const «mat m.hkdf-salt|HKDF_SALT = fromHex("000102030405060708090a0b0c")»;
const «mat m.hkdf-info|HKDF_INFO = fromHex("f0f1f2f3f4f5f6f7f8f9")»;
// RFC 7914 sections 11 and 12
const «mat m.pbkdf2-password|PBKDF2_PASSWORD = utf8("Password")»;
const «mat m.pbkdf2-salt|PBKDF2_SALT = utf8("NaCl")»;
const «mat m.scrypt-password|SCRYPT_PASSWORD = utf8("pleaseletmein")»;
const «mat m.scrypt-salt|SCRYPT_SALT = utf8("SodiumChloride")»;
const «mat m.password|PASSWORD = "correct horse battery staple"»;
const «mat m.argon2-salt|ARGON2_SALT = utf8("cbom-corpus-salt")»;
// GCM specification test case 16
const «mat m.gcm-key|GCM_KEY = fromHex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")»;
const «mat m.gcm-iv|GCM_IV = fromHex("cafebabefacedbaddecaf888")»;
const «mat m.gcm-aad|GCM_AAD = fromHex("feedfacedeadbeeffeedfacedeadbeefabaddad2")»;
const GCM_PLAINTEXT = fromHex(
  "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72" +
    "1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39",
);
// FIPS 197 appendix C.1
const «mat m.ecb-key|ECB_KEY = fromHex("000102030405060708090a0b0c0d0e0f")»;
const ECB_PLAINTEXT = fromHex("00112233445566778899aabbccddeeff");
// RFC 8032 section 7.1, TEST 1
const «mat m.ed25519-seed|ED25519_SEED = fromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")»;
const «mat m.session-info|SESSION_INFO = utf8("cbom-corpus session key v1")»;
const TLS_SERVER_NAME = "cbom-corpus.example";

function utf8(text: string): Bytes {
  return new TextEncoder().encode(text);
}

function fromHex(hex: string): Bytes {
  return new Uint8Array(Buffer.from(hex, "hex"));
}

function toHex(bytes: Uint8Array | ArrayBuffer): string {
  return Buffer.from(bytes instanceof ArrayBuffer ? new Uint8Array(bytes) : bytes).toString("hex");
}

function equal(a: Uint8Array | ArrayBuffer, b: Uint8Array): boolean {
  return Buffer.compare(Buffer.from(a instanceof ArrayBuffer ? new Uint8Array(a) : a), Buffer.from(b)) === 0;
}

function emit(scenario: string, label: string, value: string): void {
  console.log(`[${scenario}] ${label.padEnd(18)} ${value}`);
}

// S01: SHA-256 (FIPS 180-4)
function s01Sha256(): void {
  emit("S01", "SHA-256", «op:digest sha-256#$nc.Hash.digest|«ctor sha-256#$nc.createHash|crypto.createHash(«alg sha-256|"sha256"»)».update(MESSAGE).digest("hex")»);
}

// S02: SHA-512, SHA3-256, BLAKE2b-512
function s02Sha2Sha3Blake2(): void {
  emit("S02", "SHA-512", «op:digest sha-512#$nc.Hash.digest|«ctor sha-512#$nc.createHash|crypto.createHash(«alg sha-512|"sha512"»)».update(MESSAGE).digest("hex")»);
  emit("S02", "SHA3-256", toHex(«op:digest sha3-256#@noble/hashes/sha3.js:sha3_256|sha3_256(MESSAGE)»));
  emit("S02", "BLAKE2b-512", toHex(«op:digest blake2b-512#@noble/hashes/blake2.js:blake2b|blake2b(MESSAGE, { dkLen: «prm:output-length-bytes blake2b-512|64» })»));
}

// S03: legacy digests - deliberately weak
function s03LegacyHashes(): void {
  emit("S03", "MD5", «op:digest md5#$nc.Hash.digest|«ctor md5#$nc.createHash|crypto.createHash(«alg md5|"md5"»)».update(MESSAGE).digest("hex")»);
  emit("S03", "SHA-1", «op:digest sha-1#$nc.Hash.digest|«ctor sha-1#$nc.createHash|crypto.createHash(«alg sha-1|"sha1"»)».update(MESSAGE).digest("hex")»);
}

// S04: SHAKE128 extendable-output function
function s04Shake128(): void {
  const xof = «ctor shake128#$nc.createHash|crypto.createHash(«alg shake128|"shake128"», { outputLength: «prm:output-length-bytes shake128|32» })»;
  emit("S04", "SHAKE128", «op:digest shake128#$nc.Hash.digest|xof.update(MESSAGE).digest("hex")»);
}

// S05: HMAC-SHA256
function s05HmacSha256(): void {
  const mac = «ctor hmac-sha256#$nc.createHmac|crypto.createHmac(«alg sha-256^hmac-sha256|"sha256"», HMAC_KEY)»;
  emit("S05", "HMAC-SHA256", «op:tag hmac-sha256#$nc.Hmac.digest|mac.update(MESSAGE).digest("hex")»);
}

// S06: HKDF-SHA256 (RFC 5869)
function s06HkdfSha256(): void {
  const okm = «op:keyderive hkdf-sha256>m.hkdf-okm#$nc.hkdfSync|crypto.hkdfSync(«alg sha-256^hkdf-sha256|"sha256"», HKDF_IKM, HKDF_SALT, HKDF_INFO, «prm:output-length-bytes hkdf-sha256|42»)»;
  emit("S06", "HKDF-SHA256", toHex(okm));
}

// S07: PBKDF2-HMAC-SHA256 through WebCrypto
async function s07Pbkdf2(): Promise<void> {
  const baseKey = await «ctor pbkdf2-hmac-sha256#globalThis.crypto.subtle.importKey|subtle.importKey("raw", PBKDF2_PASSWORD, «alg pbkdf2-hmac-sha256|"PBKDF2"», false, ["deriveBits"])»;
  const bits = await «op:keyderive pbkdf2-hmac-sha256>m.pbkdf2-dk#globalThis.crypto.subtle.deriveBits|subtle.deriveBits(
    { name: «alg pbkdf2-hmac-sha256|"PBKDF2"», hash: «alg sha-256^pbkdf2-hmac-sha256|"SHA-256"», salt: PBKDF2_SALT, iterations: «prm:iterations pbkdf2-hmac-sha256|80_000» },
    baseKey,
    «prm:output-length-bits pbkdf2-hmac-sha256|512»,
  )»;
  emit("S07", "PBKDF2-SHA256", toHex(bits));
}

// S08: scrypt
function s08Scrypt(): void {
  const derived = «op:keyderive scrypt>m.scrypt-dk#$nc.scryptSync|crypto.scryptSync(SCRYPT_PASSWORD, SCRYPT_SALT, «prm:output-length-bytes scrypt|64», { N: «prm:N scrypt!computed|2 ** 14», r: «prm:r scrypt|8», p: «prm:p scrypt|1» })»;
  emit("S08", "scrypt", toHex(derived));
}

// S09: Argon2id
function s09Argon2id(): void {
  const raw = «op:keyderive argon2id>m.argon2-dk#@noble/hashes/argon2.js:argon2id|argon2id(utf8(PASSWORD), ARGON2_SALT, { t: «prm:iterations argon2id|2», m: «prm:memory-kib argon2id|19_456», p: «prm:parallelism argon2id|1», dkLen: «prm:output-length-bytes argon2id|32» })»;
  emit("S09", "Argon2id", toHex(raw));
}

// S10: bcrypt
function s10Bcrypt(): void {
  const salt = «op:generate csprng>m.bcrypt-salt#bcryptjs.genSaltSync|bcrypt.genSaltSync(«prm:cost bcrypt|12»)»;
  const hash = «op:keyderive bcrypt>m.bcrypt-hash#bcryptjs.hashSync|bcrypt.hashSync(PASSWORD, salt)»;
  const ok = «op:verify bcrypt#bcryptjs.compareSync|bcrypt.compareSync(PASSWORD, hash)»;
  emit("S10", "bcrypt", `verify=${ok}`);
}

// S11: AES-256-GCM known-answer test
function s11Aes256Gcm(): void {
  const encryptor = «ctor aes-256-gcm#$nc.createCipheriv!keysize-from-key|crypto.createCipheriv(«alg aes-256-gcm|"aes-256-gcm"», GCM_KEY, GCM_IV, { authTagLength: «prm:tag-length-bytes aes-256-gcm|16» })»;
  encryptor.setAAD(GCM_AAD);
  const ciphertext = «op:encrypt aes-256-gcm#$nc.Cipheriv.final|Buffer.concat([encryptor.update(GCM_PLAINTEXT), encryptor.final()])»;
  const tag = encryptor.getAuthTag();
  const decryptor = «ctor aes-256-gcm#$nc.createDecipheriv|crypto.createDecipheriv(«alg aes-256-gcm|"aes-256-gcm"», GCM_KEY, GCM_IV, { authTagLength: «prm:tag-length-bytes aes-256-gcm|16» })»;
  decryptor.setAAD(GCM_AAD);
  decryptor.setAuthTag(tag);
  const plaintext = «op:decrypt aes-256-gcm#$nc.Decipheriv.final|Buffer.concat([decryptor.update(ciphertext), decryptor.final()])»;
  emit("S11", "AES-256-GCM", `ct=${toHex(ciphertext)} tag=${toHex(tag)} roundtrip=${equal(plaintext, GCM_PLAINTEXT)}`);
}

// S12: ChaCha20-Poly1305 (RFC 8439)
function s12ChaCha20Poly1305(): void {
  const key = «op:generate csprng>m.chacha-key#@noble/ciphers/utils.js:randomBytes|randomBytes(«prm:length-bytes m.chacha-key|32»)»;
  const nonce = «op:generate csprng>m.chacha-nonce#@noble/ciphers/utils.js:randomBytes|randomBytes(«prm:length-bytes m.chacha-nonce|12»)»;
  const sealed = «op:encrypt chacha20-poly1305#@noble/ciphers/chacha.js:chacha20poly1305.encrypt|«ctor chacha20-poly1305#@noble/ciphers/chacha.js:chacha20poly1305|chacha20poly1305(key, nonce)».encrypt(MESSAGE)»;
  const opened = «op:decrypt chacha20-poly1305#@noble/ciphers/chacha.js:chacha20poly1305.decrypt|«ctor chacha20-poly1305#@noble/ciphers/chacha.js:chacha20poly1305|chacha20poly1305(key, nonce)».decrypt(sealed)»;
  emit("S12", "ChaCha20-Poly1305", `roundtrip=${equal(opened, MESSAGE)}`);
}

// S13: AES-256-CBC with PKCS#7 padding
function s13Aes256Cbc(): void {
  const key = «op:generate csprng>m.cbc-key#$nc.randomBytes|crypto.randomBytes(«prm:length-bytes m.cbc-key|32»)»;
  const iv = «op:generate csprng>m.cbc-iv#$nc.randomBytes|crypto.randomBytes(«prm:length-bytes m.cbc-iv|16»)»;
  const encryptor = «ctor aes-256-cbc#$nc.createCipheriv!openssl-default-padding|crypto.createCipheriv(«alg aes-256-cbc|"aes-256-cbc"», key, iv)»;
  const ciphertext = «op:encrypt aes-256-cbc#$nc.Cipheriv.final|Buffer.concat([encryptor.update(MESSAGE), encryptor.final()])»;
  const decryptor = «ctor aes-256-cbc#$nc.createDecipheriv!openssl-default-padding|crypto.createDecipheriv(«alg aes-256-cbc|"aes-256-cbc"», key, iv)»;
  const plaintext = «op:decrypt aes-256-cbc#$nc.Decipheriv.final|Buffer.concat([decryptor.update(ciphertext), decryptor.final()])»;
  emit("S13", "AES-256-CBC", `roundtrip=${equal(plaintext, MESSAGE)}`);
}

// S14: AES-128-ECB known-answer test - deliberately weak mode
function s14Aes128Ecb(): void {
  const encryptor = «ctor aes-128-ecb#$nc.createCipheriv!openssl-default-padding|crypto.createCipheriv(«alg aes-128-ecb|"aes-128-ecb"», ECB_KEY, null)»;
  const ciphertext = «op:encrypt aes-128-ecb#$nc.Cipheriv.final|Buffer.concat([encryptor.update(ECB_PLAINTEXT), encryptor.final()])»;
  emit("S14", "AES-128-ECB", toHex(ciphertext));
}

// S15: AES-256-CTR through WebCrypto
async function s15Aes256Ctr(): Promise<void> {
  const key = await «op:keygen aes-256-ctr>m.ctr-key#globalThis.crypto.subtle.generateKey|subtle.generateKey({ name: «alg aes-256-ctr|"AES-CTR"», length: «prm:key-size-bits aes-256-ctr|256» }, false, ["encrypt", "decrypt"])»;
  const counter = «op:generate csprng>m.ctr-iv#globalThis.crypto.getRandomValues|globalThis.crypto.getRandomValues(new Uint8Array(«prm:length-bytes m.ctr-iv|16»))»;
  const params = { name: «alg aes-256-ctr|"AES-CTR"», counter, length: «prm:counter-bits aes-256-ctr|128» };
  const ciphertext = await «op:encrypt aes-256-ctr#globalThis.crypto.subtle.encrypt|subtle.encrypt(params, key, MESSAGE)»;
  const plaintext = await «op:decrypt aes-256-ctr#globalThis.crypto.subtle.decrypt|subtle.decrypt(params, key, ciphertext)»;
  emit("S15", "AES-256-CTR", `roundtrip=${equal(plaintext, MESSAGE)}`);
}

// S16: 3DES (TDEA) CBC - deliberately legacy
function s16TdeaCbc(): void {
  const key = «op:generate csprng>m.tdes-key#$nc.randomBytes|crypto.randomBytes(«prm:length-bytes m.tdes-key|24»)»;
  const iv = «op:generate csprng>m.tdes-iv#$nc.randomBytes|crypto.randomBytes(«prm:length-bytes m.tdes-iv|8»)»;
  const encryptor = «ctor 3des-cbc#$nc.createCipheriv!openssl-default-padding|crypto.createCipheriv(«alg 3des-cbc|"des-ede3-cbc"», key, iv)»;
  const ciphertext = «op:encrypt 3des-cbc#$nc.Cipheriv.final|Buffer.concat([encryptor.update(MESSAGE), encryptor.final()])»;
  const decryptor = «ctor 3des-cbc#$nc.createDecipheriv!openssl-default-padding|crypto.createDecipheriv(«alg 3des-cbc|"des-ede3-cbc"», key, iv)»;
  const plaintext = «op:decrypt 3des-cbc#$nc.Decipheriv.final|Buffer.concat([decryptor.update(ciphertext), decryptor.final()])»;
  emit("S16", "3DES-CBC", `roundtrip=${equal(plaintext, MESSAGE)}`);
}

// S17: RSA-3072 - OAEP, PSS and PKCS#1 v1.5 with one key pair
function s17Rsa3072(): void {
  const { publicKey, privateKey } = «op:keygen rsa-3072>m.rsa-private-key,m.rsa-public-key#$nc.generateKeyPairSync|crypto.generateKeyPairSync(«alg rsa-3072|"rsa"», { modulusLength: «prm:key-size-bits rsa-3072|3072», publicExponent: «prm:public-exponent rsa-3072|0x10001» })»;

  const ciphertext = «op:encrypt rsa-oaep-sha256#$nc.publicEncrypt|crypto.publicEncrypt(
    { key: publicKey, padding: «alg rsa-oaep-sha256#$nc.constants.RSA_PKCS1_OAEP_PADDING|crypto.constants.RSA_PKCS1_OAEP_PADDING», oaepHash: «alg sha-256^rsa-oaep-sha256!oaep-mgf-same-hash|"sha256"» },
    MESSAGE,
  )»;
  const plaintext = «op:decrypt rsa-oaep-sha256#$nc.privateDecrypt|crypto.privateDecrypt(
    { key: privateKey, padding: «alg rsa-oaep-sha256#$nc.constants.RSA_PKCS1_OAEP_PADDING|crypto.constants.RSA_PKCS1_OAEP_PADDING», oaepHash: «alg sha-256^rsa-oaep-sha256!oaep-mgf-same-hash|"sha256"» },
    ciphertext,
  )»;
  emit("S17", "RSA-3072 OAEP", `roundtrip=${equal(plaintext, MESSAGE)}`);

  const pssSignature = «op:sign rsassa-pss-sha256#$nc.sign|crypto.sign(«alg sha-256^rsassa-pss-sha256|"sha256"», MESSAGE, {
    key: privateKey,
    padding: «alg rsassa-pss-sha256#$nc.constants.RSA_PKCS1_PSS_PADDING|crypto.constants.RSA_PKCS1_PSS_PADDING»,
    saltLength: «prm:salt-length-bytes rsassa-pss-sha256|32»,
  })»;
  const pssOk = «op:verify rsassa-pss-sha256#$nc.verify|crypto.verify(
    «alg sha-256^rsassa-pss-sha256|"sha256"»,
    MESSAGE,
    { key: publicKey, padding: «alg rsassa-pss-sha256#$nc.constants.RSA_PKCS1_PSS_PADDING|crypto.constants.RSA_PKCS1_PSS_PADDING», saltLength: «prm:salt-length-bytes rsassa-pss-sha256|32» },
    pssSignature,
  )»;
  emit("S17", "RSA-3072 PSS", `verify=${pssOk}`);

  const pkcs1Signature = «op:sign rsassa-pkcs1v15-sha256#$nc.sign|crypto.sign(«alg sha-256^rsassa-pkcs1v15-sha256|"sha256"», MESSAGE, {
    key: privateKey,
    padding: «alg rsassa-pkcs1v15-sha256#$nc.constants.RSA_PKCS1_PADDING|crypto.constants.RSA_PKCS1_PADDING»,
  })»;
  const pkcs1Ok = «op:verify rsassa-pkcs1v15-sha256#$nc.verify|crypto.verify(
    «alg sha-256^rsassa-pkcs1v15-sha256|"sha256"»,
    MESSAGE,
    { key: publicKey, padding: «alg rsassa-pkcs1v15-sha256#$nc.constants.RSA_PKCS1_PADDING|crypto.constants.RSA_PKCS1_PADDING» },
    pkcs1Signature,
  )»;
  emit("S17", "RSA-3072 PKCS1v15", `verify=${pkcs1Ok}`);
}

// S18: ECDSA P-256 with SHA-256 through WebCrypto
async function s18EcdsaP256(): Promise<void> {
  const keys = await «op:keygen ecdsa-p256-sha256>m.ecdsa-private-key,m.ecdsa-public-key#globalThis.crypto.subtle.generateKey|subtle.generateKey({ name: «alg ecdsa-p256-sha256|"ECDSA"», namedCurve: «alg ecdsa-p256-sha256|"P-256"» }, false, ["sign", "verify"])»;
  const algorithm = { name: «alg ecdsa-p256-sha256|"ECDSA"», hash: «alg sha-256^ecdsa-p256-sha256|"SHA-256"» };
  const signature = await «op:sign ecdsa-p256-sha256#globalThis.crypto.subtle.sign!p1363|subtle.sign(algorithm, keys.privateKey, MESSAGE)»;
  const ok = await «op:verify ecdsa-p256-sha256#globalThis.crypto.subtle.verify|subtle.verify(algorithm, keys.publicKey, signature, MESSAGE)»;
  emit("S18", "ECDSA P-256", `verify=${ok}`);
}

// S19: Ed25519 from a fixed seed (RFC 8032)
function s19Ed25519(): void {
  const publicKey = «op:keygen ed25519>m.ed25519-public-key#@noble/curves/ed25519.js:ed25519.getPublicKey!seed-ctor|ed25519.getPublicKey(ED25519_SEED)»;
  const signature = «op:sign ed25519#@noble/curves/ed25519.js:ed25519.sign|ed25519.sign(MESSAGE, ED25519_SEED)»;
  const ok = «op:verify ed25519#@noble/curves/ed25519.js:ed25519.verify|ed25519.verify(signature, MESSAGE, publicKey)»;
  emit("S19", "Ed25519", `pk=${toHex(publicKey)} sig=${toHex(signature)} verify=${ok}`);
}

function deriveSessionKey(sharedSecret: Uint8Array): Uint8Array {
  const key = «op:keyderive hkdf-sha256>m.session-key#$nc.hkdfSync|crypto.hkdfSync(«alg sha-256^hkdf-sha256|"sha256"», sharedSecret, new Uint8Array(0), SESSION_INFO, «prm:output-length-bytes hkdf-sha256|32»)»;
  return new Uint8Array(key);
}

// S20: X25519 + ECDH P-256 key agreement, HKDF session key
function s20KeyAgreement(): void {
  const alice = «op:keygen x25519>m.x25519-private-key-a#$nc.generateKeyPairSync|crypto.generateKeyPairSync(«alg x25519|"x25519"»)»;
  const bob = «op:keygen x25519>m.x25519-private-key-b#$nc.generateKeyPairSync|crypto.generateKeyPairSync(«alg x25519|"x25519"»)»;
  const xAlice = «op:agree x25519>m.x25519-shared-secret#$nc.diffieHellman|crypto.diffieHellman({ privateKey: alice.privateKey, publicKey: bob.publicKey })»;
  const xBob = «op:agree x25519>m.x25519-shared-secret#$nc.diffieHellman|crypto.diffieHellman({ privateKey: bob.privateKey, publicKey: alice.publicKey })»;
  emit("S20", "X25519", `agree=${equal(xAlice, xBob)}`);

  const aliceEc = «ctor ecdh-p256#$nc.createECDH|crypto.createECDH(«alg ecdh-p256!curve-alias|"prime256v1"»)»;
  const bobEc = «ctor ecdh-p256#$nc.createECDH|crypto.createECDH(«alg ecdh-p256!curve-alias|"prime256v1"»)»;
  const alicePublic = «op:keygen ecdh-p256>m.ecdh-private-key-a#$nc.ECDH.generateKeys|aliceEc.generateKeys()»;
  const bobPublic = «op:keygen ecdh-p256>m.ecdh-private-key-b#$nc.ECDH.generateKeys|bobEc.generateKeys()»;
  const zAlice = «op:agree ecdh-p256>m.ecdh-shared-secret#$nc.ECDH.computeSecret|aliceEc.computeSecret(bobPublic)»;
  const zBob = «op:agree ecdh-p256>m.ecdh-shared-secret#$nc.ECDH.computeSecret|bobEc.computeSecret(alicePublic)»;
  emit("S20", "ECDH P-256", `agree=${equal(zAlice, zBob)}`);

  const kAlice = deriveSessionKey(Buffer.concat([xAlice, zAlice]));
  const kBob = deriveSessionKey(Buffer.concat([xBob, zBob]));
  emit("S20", "HKDF session key", `match=${equal(kAlice, kBob)}`);
}

// S21: ML-KEM-768 (FIPS 203)
function s21MlKem768(): void {
  const { publicKey, secretKey } = «op:keygen ml-kem-768>m.mlkem-decapsulation-key,m.mlkem-encapsulation-key#@noble/post-quantum/ml-kem.js:ml_kem768.keygen|ml_kem768.keygen()»;
