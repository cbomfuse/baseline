// Command cryptoshowcase is the Go implementation of the CBOM ground-truth corpus.
//
// It runs scenarios S01-S24 in the same order, with the same inputs and the same
// output lines as the Python, Java, TypeScript and C# implementations. All
// hard-coded keys, IVs, salts and passwords are published test vectors.
package main

import (
    "bytes"
    «imp lib.go-stdlib#crypto|"crypto"»
    «imp lib.go-stdlib#crypto/aes|"crypto/aes"»
    «imp lib.go-stdlib#crypto/cipher|"crypto/cipher"»
    «imp lib.go-stdlib#crypto/des|"crypto/des"»
    «imp lib.go-stdlib#crypto/ecdh|"crypto/ecdh"»
    «imp lib.go-stdlib#crypto/ecdsa|"crypto/ecdsa"»
    «imp lib.go-stdlib#crypto/ed25519|"crypto/ed25519"»
    «imp lib.go-stdlib#crypto/elliptic|"crypto/elliptic"»
    «imp lib.go-stdlib#crypto/hkdf|"crypto/hkdf"»
    «imp lib.go-stdlib#crypto/hmac|"crypto/hmac"»
    «imp lib.go-stdlib#crypto/md5|"crypto/md5"»
    «imp lib.go-stdlib#crypto/mlkem|"crypto/mlkem"»
    «imp lib.go-stdlib#crypto/pbkdf2|"crypto/pbkdf2"»
    «imp lib.go-stdlib#crypto/rand|"crypto/rand"»
    «imp lib.go-stdlib#crypto/rsa|"crypto/rsa"»
    «imp lib.go-stdlib#crypto/sha1|"crypto/sha1"»
    «imp lib.go-stdlib#crypto/sha256|"crypto/sha256"»
    «imp lib.go-stdlib#crypto/sha3|"crypto/sha3"»
    «imp lib.go-stdlib#crypto/sha512|"crypto/sha512"»
    «imp lib.go-stdlib#crypto/tls|"crypto/tls"»
    «imp lib.go-stdlib#crypto/x509|"crypto/x509"»
    «imp lib.go-stdlib#crypto/x509/pkix|"crypto/x509/pkix"»
    "encoding/hex"
    "fmt"
    "math/big"
