// S17: RSA-3072 - OAEP, PSS and PKCS#1 v1.5 with one key pair
func s17RSA3072() {
    privateKey, err := «op:keygen rsa-3072>m.rsa-private-key,m.rsa-public-key#crypto/rsa.GenerateKey!go126-rand-ignored|rsa.GenerateKey(rand.Reader, «prm:key-size-bits rsa-3072|3072»)»
    check(err)
    publicKey := &privateKey.PublicKey

    ciphertext, err := «op:encrypt rsa-oaep-sha256#crypto/rsa.EncryptOAEP!oaep-mgf-same-hash|rsa.EncryptOAEP(«alg sha-256^rsa-oaep-sha256#crypto/sha256.New|sha256.New()», rand.Reader, publicKey, message, nil)»
    check(err)
    plaintext, err := «op:decrypt rsa-oaep-sha256#crypto/rsa.DecryptOAEP|rsa.DecryptOAEP(«alg sha-256^rsa-oaep-sha256#crypto/sha256.New|sha256.New()», nil, privateKey, ciphertext, nil)»
    check(err)
    emit("S17", "RSA-3072 OAEP", fmt.Sprintf("roundtrip=%t", bytes.Equal(plaintext, message)))

    digest := «op:digest sha-256^rsassa-pss-sha256#crypto/sha256.Sum256!prehash|«op:digest sha-256^rsassa-pkcs1v15-sha256#crypto/sha256.Sum256!prehash|sha256.Sum256(message)»»
    pssOptions := «spec rsassa-pss-sha256#crypto/rsa.PSSOptions|&rsa.PSSOptions{SaltLength: «prm:salt-length-bytes rsassa-pss-sha256#crypto/rsa.PSSSaltLengthEqualsHash|rsa.PSSSaltLengthEqualsHash»}»
    pssSignature, err := «op:sign rsassa-pss-sha256#crypto/rsa.SignPSS|rsa.SignPSS(rand.Reader, privateKey, «alg sha-256^rsassa-pss-sha256#crypto.SHA256|crypto.SHA256», digest[:], pssOptions)»
    check(err)
    pssOK := «op:verify rsassa-pss-sha256#crypto/rsa.VerifyPSS|rsa.VerifyPSS(publicKey, «alg sha-256^rsassa-pss-sha256#crypto.SHA256|crypto.SHA256», digest[:], pssSignature, pssOptions)» == nil
    emit("S17", "RSA-3072 PSS", fmt.Sprintf("verify=%t", pssOK))

    pkcs1Signature, err := «op:sign rsassa-pkcs1v15-sha256#crypto/rsa.SignPKCS1v15|rsa.SignPKCS1v15(nil, privateKey, «alg sha-256^rsassa-pkcs1v15-sha256#crypto.SHA256|crypto.SHA256», digest[:])»
    check(err)
    pkcs1OK := «op:verify rsassa-pkcs1v15-sha256#crypto/rsa.VerifyPKCS1v15|rsa.VerifyPKCS1v15(publicKey, «alg sha-256^rsassa-pkcs1v15-sha256#crypto.SHA256|crypto.SHA256», digest[:], pkcs1Signature)» == nil
    emit("S17", "RSA-3072 PKCS1v15", fmt.Sprintf("verify=%t", pkcs1OK))
}

// S18: ECDSA P-256 with SHA-256
func s18ECDSAP256() {
    privateKey, err := «op:keygen ecdsa-p256-sha256>m.ecdsa-private-key,m.ecdsa-public-key#crypto/ecdsa.GenerateKey!go126-rand-ignored|ecdsa.GenerateKey(«alg ecdsa-p256-sha256#crypto/elliptic.P256|elliptic.P256()», rand.Reader)»
    check(err)
    digest := «op:digest sha-256^ecdsa-p256-sha256#crypto/sha256.Sum256!prehash|sha256.Sum256(message)»
    signature, err := «op:sign ecdsa-p256-sha256#crypto/ecdsa.SignASN1!go126-rand-ignored|ecdsa.SignASN1(rand.Reader, privateKey, digest[:])»
    check(err)
    ok := «op:verify ecdsa-p256-sha256#crypto/ecdsa.VerifyASN1|ecdsa.VerifyASN1(&privateKey.PublicKey, digest[:], signature)»
    emit("S18", "ECDSA P-256", fmt.Sprintf("verify=%t", ok))
}

// S19: Ed25519 from a fixed seed (RFC 8032)
func s19Ed25519() {
    privateKey := «op:keygen ed25519>m.ed25519-public-key#crypto/ed25519.NewKeyFromSeed!seed-ctor|ed25519.NewKeyFromSeed(ed25519Seed)»
    publicKey := privateKey.Public().(«typ ed25519#crypto/ed25519.PublicKey|ed25519.PublicKey»)
    signature := «op:sign ed25519#crypto/ed25519.Sign|ed25519.Sign(privateKey, message)»
    ok := «op:verify ed25519#crypto/ed25519.Verify|ed25519.Verify(publicKey, message, signature)»
    emit("S19", "Ed25519", fmt.Sprintf("pk=%x sig=%x verify=%t", []byte(publicKey), signature, ok))
}

func deriveSessionKey(sharedSecret []byte) []byte {
    key, err := «op:keyderive hkdf-sha256>m.session-key#crypto/hkdf.Key|hkdf.Key(«alg sha-256^hkdf-sha256#crypto/sha256.New!hash-constructor|sha256.New», sharedSecret, nil, sessionInfo, «prm:output-length-bytes hkdf-sha256|32»)»
    check(err)
    return key
}

// S20: X25519 + ECDH P-256 key agreement, HKDF session key
func s20KeyAgreement() {
    x25519 := «alg x25519#crypto/ecdh.X25519|ecdh.X25519()»
    alice, err := «op:keygen x25519>m.x25519-private-key-a#crypto/ecdh.Curve.GenerateKey!go126-rand-ignored|x25519.GenerateKey(rand.Reader)»
    check(err)
    bob, err := «op:keygen x25519>m.x25519-private-key-b#crypto/ecdh.Curve.GenerateKey!go126-rand-ignored|x25519.GenerateKey(rand.Reader)»
    check(err)
    xAlice, err := «op:agree x25519>m.x25519-shared-secret#crypto/ecdh.PrivateKey.ECDH|alice.ECDH(bob.PublicKey())»
    check(err)
    xBob, err := «op:agree x25519>m.x25519-shared-secret#crypto/ecdh.PrivateKey.ECDH|bob.ECDH(alice.PublicKey())»
    check(err)
    emit("S20", "X25519", fmt.Sprintf("agree=%t", bytes.Equal(xAlice, xBob)))

    p256 := «alg ecdh-p256#crypto/ecdh.P256|ecdh.P256()»
    aliceEC, err := «op:keygen ecdh-p256>m.ecdh-private-key-a#crypto/ecdh.Curve.GenerateKey!go126-rand-ignored|p256.GenerateKey(rand.Reader)»
    check(err)
    bobEC, err := «op:keygen ecdh-p256>m.ecdh-private-key-b#crypto/ecdh.Curve.GenerateKey!go126-rand-ignored|p256.GenerateKey(rand.Reader)»
    check(err)
    zAlice, err := «op:agree ecdh-p256>m.ecdh-shared-secret#crypto/ecdh.PrivateKey.ECDH|aliceEC.ECDH(bobEC.PublicKey())»
    check(err)
    zBob, err := «op:agree ecdh-p256>m.ecdh-shared-secret#crypto/ecdh.PrivateKey.ECDH|bobEC.ECDH(aliceEC.PublicKey())»
    check(err)
    emit("S20", "ECDH P-256", fmt.Sprintf("agree=%t", bytes.Equal(zAlice, zBob)))

    kAlice := deriveSessionKey(append(bytes.Clone(xAlice), zAlice...))
    kBob := deriveSessionKey(append(bytes.Clone(xBob), zBob...))
    emit("S20", "HKDF session key", fmt.Sprintf("match=%t", bytes.Equal(kAlice, kBob)))
}

// S21: ML-KEM-768 (FIPS 203)
func s21MLKEM768() {
    decapsulationKey, err := «op:keygen ml-kem-768>m.mlkem-decapsulation-key,m.mlkem-encapsulation-key#crypto/mlkem.GenerateKey768|mlkem.GenerateKey768()»
    check(err)
    sharedSecret, ciphertext := «op:encapsulate ml-kem-768>m.mlkem-shared-secret#crypto/mlkem.EncapsulationKey768.Encapsulate|decapsulationKey.EncapsulationKey().Encapsulate()»
    recovered, err := «op:decapsulate ml-kem-768>m.mlkem-shared-secret#crypto/mlkem.DecapsulationKey768.Decapsulate|decapsulationKey.Decapsulate(ciphertext)»
    check(err)
    emit("S21", "ML-KEM-768", fmt.Sprintf("agree=%t ct=%d ss=%d", bytes.Equal(sharedSecret, recovered), len(ciphertext), len(sharedSecret)))
}

// S22: ML-DSA-65 (FIPS 204)
func s22MLDSA65() {
    publicKey, privateKey, err := «op:keygen ml-dsa-65>m.mldsa-private-key,m.mldsa-public-key#$circl/sign/mldsa/mldsa65.GenerateKey|mldsa65.GenerateKey(rand.Reader)»
    check(err)
    signature := make([]byte, «prm:signature-size-bytes ml-dsa-65#$circl/sign/mldsa/mldsa65.SignatureSize|mldsa65.SignatureSize»)
    check(«op:sign ml-dsa-65#$circl/sign/mldsa/mldsa65.SignTo!ctx-default|mldsa65.SignTo(privateKey, message, nil, «prm:randomized ml-dsa-65!hedged|true», signature)»)
    ok := «op:verify ml-dsa-65#$circl/sign/mldsa/mldsa65.Verify|mldsa65.Verify(publicKey, message, nil, signature)»
    emit("S22", "ML-DSA-65", fmt.Sprintf("verify=%t sig=%d", ok, len(signature)))
}

// S23: self-signed X.509 certificate
func s23X509SelfSigned() {
    key, err := «op:keygen ecdsa-p256-sha256>m.cert-private-key,m.cert-public-key#crypto/ecdsa.GenerateKey!go126-rand-ignored|ecdsa.GenerateKey(«alg ecdsa-p256-sha256#crypto/elliptic.P256|elliptic.P256()», rand.Reader)»
    check(err)
    serial, err := «op:generate csprng#crypto/rand.Int!serial|rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 64))»
    check(err)
    now := time.Now()
    template := «ctor cert.self-signed#crypto/x509.Certificate|&x509.Certificate{
        SerialNumber:       serial,
        Subject:            pkix.Name{CommonName: tlsServerName},
        NotBefore:          now.Add(-time.Minute),
        NotAfter:           now.Add(«prm:validity-days cert.self-signed|365» * 24 * time.Hour),
        SignatureAlgorithm: «alg ecdsa-p256-sha256#crypto/x509.ECDSAWithSHA256|x509.ECDSAWithSHA256»,
    }»
    der, err := «op:sign cert.self-signed#crypto/x509.CreateCertificate|x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)»
    check(err)
    certificate, err := «op:encode cert.self-signed#crypto/x509.ParseCertificate|x509.ParseCertificate(der)»
    check(err)
    ok := «op:verify ecdsa-p256-sha256#crypto/x509.Certificate.CheckSignature|certificate.CheckSignature(certificate.SignatureAlgorithm, certificate.RawTBSCertificate, certificate.Signature)» == nil
    emit("S23", "X.509 self-signed", fmt.Sprintf("verify=%t", ok))
}

// S24: TLS 1.3-only client configuration (no connection is made)
func s24TLS13Client() {
    config := «ctor tls13-client#crypto/tls.Config|&tls.Config{
