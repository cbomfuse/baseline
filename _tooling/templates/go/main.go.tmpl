    key := make([]byte, «prm:length-bytes m.tdes-key|24»)
    «op:generate csprng>m.tdes-key#crypto/rand.Read|rand.Read(key)»
    iv := make([]byte, «prm:length-bytes m.tdes-iv#crypto/des.BlockSize|des.BlockSize»)
    «op:generate csprng>m.tdes-iv#crypto/rand.Read|rand.Read(iv)»
    block, err := «ctor 3des-cbc#crypto/des.NewTripleDESCipher|des.NewTripleDESCipher(key)»
    check(err)
    padded := «alg 3des-cbc!manual-pkcs7|pkcs7Pad(message, des.BlockSize)»
    ciphertext := make([]byte, len(padded))
    «op:encrypt 3des-cbc#crypto/cipher.BlockMode.CryptBlocks|«ctor:encrypt 3des-cbc#crypto/cipher.NewCBCEncrypter!mode-ctor|cipher.NewCBCEncrypter(block, iv)».CryptBlocks(ciphertext, padded)»
    plaintext := make([]byte, len(ciphertext))
