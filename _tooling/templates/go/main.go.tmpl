        MaxVersion: «cfg:max-version tls13-client#crypto/tls.VersionTLS13|tls.VersionTLS13»,
        ServerName: tlsServerName,
    }»
    emit("S24", "TLS 1.3 client", fmt.Sprintf("configured=%t", config != nil))
}

