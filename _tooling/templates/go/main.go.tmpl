    «imp lib.circl#$circl/sign/mldsa/mldsa65|"github.com/cloudflare/circl/sign/mldsa/mldsa65"»
    «imp lib.xcrypto#$x/argon2|"golang.org/x/crypto/argon2"»
    «imp lib.xcrypto#$x/bcrypt|"golang.org/x/crypto/bcrypt"»
    «imp lib.xcrypto#$x/blake2b|"golang.org/x/crypto/blake2b"»
    «imp lib.xcrypto#$x/chacha20poly1305|"golang.org/x/crypto/chacha20poly1305"»
    «imp lib.xcrypto#$x/scrypt|"golang.org/x/crypto/scrypt"»
)

var message = []byte("The quick brown fox jumps over the lazy dog")

// Hard-coded material (public test vectors only): Wikipedia HMAC example key,
// RFC 5869 A.1, RFC 7914 sections 11 and 12, GCM specification test case 16,
// FIPS 197 appendix C.1 and RFC 8032 section 7.1 TEST 1.
var «mat m.hmac-key|hmacKey = []byte("key")»
var «mat m.hkdf-ikm|hkdfIKM = bytes.Repeat([]byte{0x0b}, 22)»
var «mat m.hkdf-salt|hkdfSalt = mustHex("000102030405060708090a0b0c")»
var «mat m.hkdf-info|hkdfInfo = mustHex("f0f1f2f3f4f5f6f7f8f9")»
var «mat m.pbkdf2-password|pbkdf2Password = "Password"»
var «mat m.pbkdf2-salt|pbkdf2Salt = []byte("NaCl")»
var «mat m.scrypt-password|scryptPassword = []byte("pleaseletmein")»
var «mat m.scrypt-salt|scryptSalt = []byte("SodiumChloride")»
var «mat m.password|password = []byte("correct horse battery staple")»
var «mat m.argon2-salt|argon2Salt = []byte("cbom-corpus-salt")»
var «mat m.gcm-key|gcmKey = mustHex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")»
var «mat m.gcm-iv|gcmIV = mustHex("cafebabefacedbaddecaf888")»
var «mat m.gcm-aad|gcmAAD = mustHex("feedfacedeadbeeffeedfacedeadbeefabaddad2")»
var gcmPlaintext = mustHex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72" +
    "1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
var «mat m.ecb-key|ecbKey = mustHex("000102030405060708090a0b0c0d0e0f")»
var ecbPlaintext = mustHex("00112233445566778899aabbccddeeff")
var «mat m.ed25519-seed|ed25519Seed = mustHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")»
var «mat m.session-info|sessionInfo = "cbom-corpus session key v1"»

const tlsServerName = "cbom-corpus.example"

func mustHex(s string) []byte {
    b, err := hex.DecodeString(s)
    if err != nil {
        panic(err)
    }
    return b
}

func check(err error) {
    if err != nil {
        panic(err)
    }
}

func emit(scenario, label, value string) {
    fmt.Printf("[%s] %-18s %s\n", scenario, label, value)
}

func pkcs7Pad(data []byte, blockSize int) []byte {
    n := blockSize - len(data)%blockSize
    return append(bytes.Clone(data), bytes.Repeat([]byte{byte(n)}, n)...)
}

func pkcs7Unpad(data []byte) []byte {
    n := int(data[len(data)-1])
    if n == 0 || n > len(data) {
        panic("invalid padding")
    }
    return data[:len(data)-n]
}

// S01: SHA-256 (FIPS 180-4)
func s01SHA256() {
    digest := «op:digest sha-256#crypto/sha256.Sum256|sha256.Sum256(message)»
    emit("S01", "SHA-256", hex.EncodeToString(digest[:]))
}

// S02: SHA-512, SHA3-256, BLAKE2b-512
func s02SHA2SHA3BLAKE2() {
    sha512Digest := «op:digest sha-512#crypto/sha512.Sum512|sha512.Sum512(message)»
    emit("S02", "SHA-512", hex.EncodeToString(sha512Digest[:]))
    sha3Digest := «op:digest sha3-256#crypto/sha3.Sum256|sha3.Sum256(message)»
    emit("S02", "SHA3-256", hex.EncodeToString(sha3Digest[:]))
    blakeDigest := «op:digest blake2b-512#$x/blake2b.Sum512|blake2b.Sum512(message)»
    emit("S02", "BLAKE2b-512", hex.EncodeToString(blakeDigest[:]))
}

// S03: legacy digests - deliberately weak
func s03LegacyHashes() {
    md5Digest := «op:digest md5#crypto/md5.Sum|md5.Sum(message)»
    emit("S03", "MD5", hex.EncodeToString(md5Digest[:]))
    sha1Digest := «op:digest sha-1#crypto/sha1.Sum|sha1.Sum(message)»
    emit("S03", "SHA-1", hex.EncodeToString(sha1Digest[:]))
}

// S04: SHAKE128 extendable-output function
func s04SHAKE128() {
    out := «op:digest shake128#crypto/sha3.SumSHAKE128|sha3.SumSHAKE128(message, «prm:output-length-bytes shake128|32»)»
    emit("S04", "SHAKE128", hex.EncodeToString(out))
}

// S05: HMAC-SHA256
func s05HMACSHA256() {
    mac := «ctor hmac-sha256#crypto/hmac.New|hmac.New(«alg sha-256^hmac-sha256#crypto/sha256.New!hash-constructor|sha256.New», hmacKey)»
    mac.Write(message)
    emit("S05", "HMAC-SHA256", hex.EncodeToString(«op:tag hmac-sha256#hash.Hash.Sum|mac.Sum(nil)»))
}

// S06: HKDF-SHA256 (RFC 5869)
func s06HKDFSHA256() {
    okm, err := «op:keyderive hkdf-sha256>m.hkdf-okm#crypto/hkdf.Key|hkdf.Key(«alg sha-256^hkdf-sha256#crypto/sha256.New!hash-constructor|sha256.New», hkdfIKM, hkdfSalt, string(hkdfInfo), «prm:output-length-bytes hkdf-sha256|42»)»
    check(err)
    emit("S06", "HKDF-SHA256", hex.EncodeToString(okm))
}

// S07: PBKDF2-HMAC-SHA256
func s07PBKDF2() {
    derived, err := «op:keyderive pbkdf2-hmac-sha256>m.pbkdf2-dk#crypto/pbkdf2.Key|pbkdf2.Key(«alg sha-256^pbkdf2-hmac-sha256#crypto/sha256.New!hash-constructor|sha256.New», pbkdf2Password, pbkdf2Salt, «prm:iterations pbkdf2-hmac-sha256|80_000», «prm:output-length-bytes pbkdf2-hmac-sha256|64»)»
    check(err)
    emit("S07", "PBKDF2-SHA256", hex.EncodeToString(derived))
}

// S08: scrypt
func s08Scrypt() {
    derived, err := «op:keyderive scrypt>m.scrypt-dk#$x/scrypt.Key|scrypt.Key(scryptPassword, scryptSalt, «prm:N scrypt!computed|1<<14», «prm:r scrypt|8», «prm:p scrypt|1», «prm:output-length-bytes scrypt|64»)»
    check(err)
    emit("S08", "scrypt", hex.EncodeToString(derived))
}

// S09: Argon2id
func s09Argon2id() {
    raw := «op:keyderive argon2id>m.argon2-dk#$x/argon2.IDKey!mode-ctor|argon2.IDKey(password, argon2Salt, «prm:iterations argon2id|2», «prm:memory-kib argon2id|19_456», «prm:parallelism argon2id|1», «prm:output-length-bytes argon2id|32»)»
    emit("S09", "Argon2id", hex.EncodeToString(raw))
}

// S10: bcrypt
func s10Bcrypt() {
    hash, err := «op:keyderive bcrypt>m.bcrypt-hash,m.bcrypt-salt#$x/bcrypt.GenerateFromPassword!bcrypt-internal-salt|bcrypt.GenerateFromPassword(password, «prm:cost bcrypt|12»)»
    check(err)
    ok := «op:verify bcrypt#$x/bcrypt.CompareHashAndPassword|bcrypt.CompareHashAndPassword(hash, password)» == nil
    emit("S10", "bcrypt", fmt.Sprintf("verify=%t", ok))
}

// S11: AES-256-GCM known-answer test
func s11AES256GCM() {
    block, err := «ctor aes-256-gcm#crypto/aes.NewCipher!keysize-from-key|aes.NewCipher(gcmKey)»
    check(err)
    aead, err := «ctor aes-256-gcm#crypto/cipher.NewGCM!mode-ctor|cipher.NewGCM(block)»
    check(err)
    sealed := «op:encrypt aes-256-gcm#crypto/cipher.AEAD.Seal|aead.Seal(nil, gcmIV, gcmPlaintext, gcmAAD)»
    opened, err := «op:decrypt aes-256-gcm#crypto/cipher.AEAD.Open|aead.Open(nil, gcmIV, sealed, gcmAAD)»
    check(err)
    tagStart := len(sealed) - aead.Overhead()
    emit("S11", "AES-256-GCM", fmt.Sprintf("ct=%x tag=%x roundtrip=%t", sealed[:tagStart], sealed[tagStart:], bytes.Equal(opened, gcmPlaintext)))
}

// S12: ChaCha20-Poly1305 (RFC 8439)
func s12ChaCha20Poly1305() {
    key := make([]byte, «prm:length-bytes m.chacha-key#$x/chacha20poly1305.KeySize|chacha20poly1305.KeySize»)
    «op:generate csprng>m.chacha-key#crypto/rand.Read|rand.Read(key)»
    nonce := make([]byte, «prm:length-bytes m.chacha-nonce#$x/chacha20poly1305.NonceSize|chacha20poly1305.NonceSize»)
    «op:generate csprng>m.chacha-nonce#crypto/rand.Read|rand.Read(nonce)»
    aead, err := «ctor chacha20-poly1305#$x/chacha20poly1305.New|chacha20poly1305.New(key)»
    check(err)
    sealed := «op:encrypt chacha20-poly1305#crypto/cipher.AEAD.Seal|aead.Seal(nil, nonce, message, nil)»
    opened, err := «op:decrypt chacha20-poly1305#crypto/cipher.AEAD.Open|aead.Open(nil, nonce, sealed, nil)»
    check(err)
    emit("S12", "ChaCha20-Poly1305", fmt.Sprintf("roundtrip=%t", bytes.Equal(opened, message)))
}

// S13: AES-256-CBC with PKCS#7 padding
func s13AES256CBC() {
    key := make([]byte, «prm:length-bytes m.cbc-key|32»)
    «op:generate csprng>m.cbc-key#crypto/rand.Read|rand.Read(key)»
    iv := make([]byte, «prm:length-bytes m.cbc-iv#crypto/aes.BlockSize|aes.BlockSize»)
    «op:generate csprng>m.cbc-iv#crypto/rand.Read|rand.Read(iv)»
    block, err := «ctor aes-256-cbc#crypto/aes.NewCipher!keysize-from-key|aes.NewCipher(key)»
    check(err)
    padded := «alg aes-256-cbc!manual-pkcs7|pkcs7Pad(message, aes.BlockSize)»
    ciphertext := make([]byte, len(padded))
    «op:encrypt aes-256-cbc#crypto/cipher.BlockMode.CryptBlocks|«ctor:encrypt aes-256-cbc#crypto/cipher.NewCBCEncrypter!mode-ctor|cipher.NewCBCEncrypter(block, iv)».CryptBlocks(ciphertext, padded)»
    plaintext := make([]byte, len(ciphertext))
    «op:decrypt aes-256-cbc#crypto/cipher.BlockMode.CryptBlocks|«ctor:decrypt aes-256-cbc#crypto/cipher.NewCBCDecrypter!mode-ctor|cipher.NewCBCDecrypter(block, iv)».CryptBlocks(plaintext, ciphertext)»
    emit("S13", "AES-256-CBC", fmt.Sprintf("roundtrip=%t", bytes.Equal(«alg aes-256-cbc!manual-pkcs7|pkcs7Unpad(plaintext)», message)))
}

// S14: AES-128-ECB known-answer test - deliberately weak mode
func s14AES128ECB() {
    block, err := «ctor aes-128-ecb#crypto/aes.NewCipher!keysize-from-key|aes.NewCipher(ecbKey)»
    check(err)
    padded := «alg aes-128-ecb!manual-pkcs7|pkcs7Pad(ecbPlaintext, aes.BlockSize)»
    ciphertext := make([]byte, len(padded))
    for i := 0; i < len(padded); i += «prm:block-size-bytes aes-128-ecb#crypto/aes.BlockSize!manual-ecb|aes.BlockSize» {
        «op:encrypt aes-128-ecb#crypto/cipher.Block.Encrypt!manual-ecb|block.Encrypt(ciphertext[i:i+aes.BlockSize], padded[i:i+aes.BlockSize])»
    }
    emit("S14", "AES-128-ECB", hex.EncodeToString(ciphertext))
}

// S15: AES-256-CTR
func s15AES256CTR() {
    key := make([]byte, «prm:length-bytes m.ctr-key|32»)
    «op:generate csprng>m.ctr-key#crypto/rand.Read|rand.Read(key)»
    counterBlock := make([]byte, «prm:length-bytes m.ctr-iv#crypto/aes.BlockSize|aes.BlockSize»)
    «op:generate csprng>m.ctr-iv#crypto/rand.Read|rand.Read(counterBlock)»
    block, err := «ctor aes-256-ctr#crypto/aes.NewCipher!keysize-from-key|aes.NewCipher(key)»
    check(err)
    ciphertext := make([]byte, len(message))
    «op:encrypt aes-256-ctr#crypto/cipher.Stream.XORKeyStream|«ctor:encrypt aes-256-ctr#crypto/cipher.NewCTR!mode-ctor|cipher.NewCTR(block, counterBlock)».XORKeyStream(ciphertext, message)»
    plaintext := make([]byte, len(ciphertext))
    «op:decrypt aes-256-ctr#crypto/cipher.Stream.XORKeyStream|«ctor:decrypt aes-256-ctr#crypto/cipher.NewCTR!mode-ctor|cipher.NewCTR(block, counterBlock)».XORKeyStream(plaintext, ciphertext)»
    emit("S15", "AES-256-CTR", fmt.Sprintf("roundtrip=%t", bytes.Equal(plaintext, message)))
}

