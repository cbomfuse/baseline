        var contentSigner = «ctor ecdsa-p256-sha256#$bc.operator.jcajce.JcaContentSignerBuilder.build|new JcaContentSignerBuilder(«alg ecdsa-p256-sha256|"SHA256withECDSA"»).build(keyPair.getPrivate())»;
