    // S11: AES-256-GCM known-answer test
    static void s11Aes256Gcm() throws Exception {
        var key = «spec aes-256-gcm#$jc.spec.SecretKeySpec.<init>!keysize-from-key|new SecretKeySpec(GCM_KEY, «alg aes-256-gcm|"AES"»)»;
        var gcm = «spec aes-256-gcm#$jc.spec.GCMParameterSpec.<init>|new GCMParameterSpec(«prm:tag-length-bits aes-256-gcm|128», GCM_IV)»;
        var encryptor = «ctor aes-256-gcm#$jc.Cipher.getInstance|Cipher.getInstance(«alg aes-256-gcm|"AES/GCM/NoPadding"»)»;
        «init:encrypt aes-256-gcm#$jc.Cipher.init|encryptor.init(Cipher.ENCRYPT_MODE, key, gcm)»;
        encryptor.updateAAD(GCM_AAD);
        var sealed = «op:encrypt aes-256-gcm#$jc.Cipher.doFinal|encryptor.doFinal(GCM_PLAINTEXT)»;
        var decryptor = «ctor aes-256-gcm#$jc.Cipher.getInstance|Cipher.getInstance(«alg aes-256-gcm|"AES/GCM/NoPadding"»)»;
        «init:decrypt aes-256-gcm#$jc.Cipher.init|decryptor.init(Cipher.DECRYPT_MODE, key, gcm)»;
        decryptor.updateAAD(GCM_AAD);
        var opened = «op:decrypt aes-256-gcm#$jc.Cipher.doFinal|decryptor.doFinal(sealed)»;
        var ciphertext = Arrays.copyOfRange(sealed, 0, sealed.length - 16);
        var tag = Arrays.copyOfRange(sealed, sealed.length - 16, sealed.length);
        emit("S11", "AES-256-GCM", "ct=" + toHex(ciphertext) + " tag=" + toHex(tag)
                + " roundtrip=" + Arrays.equals(opened, GCM_PLAINTEXT));
    }

