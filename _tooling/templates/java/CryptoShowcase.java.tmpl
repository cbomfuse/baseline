    static byte[] agree(String algorithm, PrivateKey privateKey, PublicKey peerKey) throws Exception {
        var agreement = «ctor x25519#$jc.KeyAgreement.getInstance!polymorphic-site|«ctor ecdh-p256#$jc.KeyAgreement.getInstance!polymorphic-site|KeyAgreement.getInstance(algorithm)»»;
