        var sha3 = «ctor sha3-256#$js.MessageDigest.getInstance|MessageDigest.getInstance(«alg sha3-256|"SHA3-256"»)»;
        emit("S02", "SHA3-256", toHex(«op:digest sha3-256#$js.MessageDigest.digest|sha3.digest(MESSAGE)»));
        var blake = «ctor blake2b-512#$bc.crypto.digests.Blake2bDigest.<init>|new Blake2bDigest(«prm:digest-size-bits blake2b-512|512»)»;
        blake.update(MESSAGE, 0, MESSAGE.length);
        var out = new byte[blake.getDigestSize()];
        «op:digest blake2b-512#$bc.crypto.digests.Blake2bDigest.doFinal|blake.doFinal(out, 0)»;
        emit("S02", "BLAKE2b-512", toHex(out));
    }

