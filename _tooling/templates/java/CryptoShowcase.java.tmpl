    // S20: X25519 + ECDH P-256 key agreement, HKDF session key
    static void s20KeyAgreement() throws Exception {
        var x25519 = «ctor x25519#$js.KeyPairGenerator.getInstance|KeyPairGenerator.getInstance(«alg x25519|"X25519"»)»;
        var alice = «op:keygen x25519>m.x25519-private-key-a#$js.KeyPairGenerator.generateKeyPair|x25519.generateKeyPair()»;
        var bob = «op:keygen x25519>m.x25519-private-key-b#$js.KeyPairGenerator.generateKeyPair|x25519.generateKeyPair()»;
        var xAlice = agree(«alg x25519!interprocedural|"X25519"», alice.getPrivate(), bob.getPublic());
        var xBob = agree(«alg x25519!interprocedural|"X25519"», bob.getPrivate(), alice.getPublic());
        emit("S20", "X25519", "agree=" + Arrays.equals(xAlice, xBob));

        var ec = «ctor ecdh-p256#$js.KeyPairGenerator.getInstance|KeyPairGenerator.getInstance(«alg ecdh-p256!ec-keygen-label|"EC"»)»;
        «init ecdh-p256#$js.KeyPairGenerator.initialize|ec.initialize(«spec ecdh-p256#$js.spec.ECGenParameterSpec.<init>|new ECGenParameterSpec(«alg ecdh-p256!curve-alias|"secp256r1"»)»)»;
        var aliceEc = «op:keygen ecdh-p256>m.ecdh-private-key-a#$js.KeyPairGenerator.generateKeyPair|ec.generateKeyPair()»;
        var bobEc = «op:keygen ecdh-p256>m.ecdh-private-key-b#$js.KeyPairGenerator.generateKeyPair|ec.generateKeyPair()»;
        var zAlice = agree(«alg ecdh-p256!interprocedural|"ECDH"», aliceEc.getPrivate(), bobEc.getPublic());
        var zBob = agree(«alg ecdh-p256!interprocedural|"ECDH"», bobEc.getPrivate(), aliceEc.getPublic());
        emit("S20", "ECDH P-256", "agree=" + Arrays.equals(zAlice, zBob));

        var kAlice = deriveSessionKey(concat(xAlice, zAlice));
        var kBob = deriveSessionKey(concat(xBob, zBob));
        emit("S20", "HKDF session key", "match=" + Arrays.equals(kAlice, kBob));
    }

