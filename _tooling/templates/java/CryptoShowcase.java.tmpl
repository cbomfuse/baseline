    static byte[] deriveSessionKey(byte[] sharedSecret) throws Exception {
        var hkdf = «ctor hkdf-sha256#$jc.KDF.getInstance|KDF.getInstance(«alg hkdf-sha256|"HKDF-SHA256"»)»;
        var params = «spec hkdf-sha256#$jc.spec.HKDFParameterSpec.ofExtract|HKDFParameterSpec.ofExtract().addIKM(sharedSecret).thenExpand(SESSION_INFO, «prm:output-length-bytes hkdf-sha256|32»)»;
