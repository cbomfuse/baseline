    private static final byte[] «mat m.gcm-iv|GCM_IV = fromHex("cafebabefacedbaddecaf888")»;
    private static final byte[] «mat m.gcm-aad|GCM_AAD = fromHex("feedfacedeadbeeffeedfacedeadbeefabaddad2")»;
    private static final byte[] GCM_PLAINTEXT = fromHex(
            "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72"
                    + "1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39");
