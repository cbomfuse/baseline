    static void s01Sha256() throws Exception {
        var md = «ctor sha-256#$js.MessageDigest.getInstance|MessageDigest.getInstance(«alg sha-256|"SHA-256"»)»;
        emit("S01", "SHA-256", toHex(«op:digest sha-256#$js.MessageDigest.digest|md.digest(MESSAGE)»));
    }

