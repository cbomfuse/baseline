        var builder = «ctor cert.self-signed#$bc.cert.jcajce.JcaX509v3CertificateBuilder.<init>|new JcaX509v3CertificateBuilder(
                name,
                «op:generate csprng#java.math.BigInteger.<init>!serial|new BigInteger(64, RNG)»,
                Date.from(now.minus(Duration.ofMinutes(1))),
                Date.from(now.plus(Duration.ofDays(«prm:validity-days cert.self-signed|365»))),
                name,
