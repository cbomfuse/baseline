    private static final byte[] «mat m.hkdf-salt|HKDF_SALT = fromHex("000102030405060708090a0b0c")»;
    private static final byte[] «mat m.hkdf-info|HKDF_INFO = fromHex("f0f1f2f3f4f5f6f7f8f9")»;
    // RFC 7914 sections 11 and 12
    private static final String «mat m.pbkdf2-password|PBKDF2_PASSWORD = "Password"»;
    private static final byte[] «mat m.pbkdf2-salt|PBKDF2_SALT = ascii("NaCl")»;
    private static final byte[] «mat m.scrypt-password|SCRYPT_PASSWORD = ascii("pleaseletmein")»;
    private static final byte[] «mat m.scrypt-salt|SCRYPT_SALT = ascii("SodiumChloride")»;
    private static final String «mat m.password|PASSWORD = "correct horse battery staple"»;
    private static final byte[] «mat m.argon2-salt|ARGON2_SALT = ascii("cbom-corpus-salt")»;
